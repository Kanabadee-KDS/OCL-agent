# คัดลอกเป็น .env แล้วแก้ค่า (.env ไม่เข้า git)

# ---- LLM ----
LLM_PROVIDER=ollama                 # ollama | gemini
# dev บน Mac/เครื่องอื่นใน Tailscale:
OLLAMA_BASE_URL=http://100.104.172.122:11434
# ใน container บน server ใช้: http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:26b             # ห้ามตั้งเป็น gemma4:12b พร้อม keep_alive (ดู docs/server-constraints.md)
OLLAMA_NUM_CTX=32768                # ส่งทุกคำขอ ไม่ปล่อยให้ Ollama ใช้ค่าเริ่มต้น 262144
OLLAMA_KEEP_ALIVE=10m               # คืนหน่วยความจำเมื่อว่าง (ว่างไว้ = ไม่ส่ง field นี้)
OLLAMA_THINK=false                  # ปิด thinking ของ gemma4 ไม่งั้น reasoning กิน max_tokens
GEMINI_API_KEY=                     # เพิ่มภายหลัง

# ---- Storage ----
DATA_DIR=./data                     # ใน container: /server_data

# ---- Database ----
# dev: Neon pooled connection string (ต้องมี sslmode=require) · prod: postgres container ใน compose ocl
DATABASE_URL=

# ---- API ----
API_HOST=127.0.0.1
API_PORT=8000
