# คัดลอกเป็น deploy/.env บน server (ไม่เข้า git)
LLM_PROVIDER=ollama
OLLAMA_MODEL=gemma4:26b
OLLAMA_NUM_CTX=32768
OLLAMA_KEEP_ALIVE=10m
OLLAMA_THINK=false
# Cloud AI (ปุ่ม 'Cloud AI · Gemini' เปิดเองเมื่อมี key) · key ส่งเป็น header ไม่อยู่ใน URL/log
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Gemini 3.x คิด (thinking) ก่อนตอบ และนับรวมใน maxOutputTokens: งานสกัดไม่ต้องใช้ จึงปิด (0) · ว่าง = ค่าเริ่มต้นของโมเดล
GEMINI_THINKING_BUDGET=0
# ตัวอย่าง few-shot จากเล่ม golden: off (ค่าเริ่มต้น) | approved (หลังทีมตรวจและวัดผลแล้ว) · ดู docs/testing/fewshot-review-guide_ocl.md
FEWSHOT=off
# พอร์ตและ IP ที่ Caddy เปิด (ต้องเป็น IP Tailscale ตามกติกาข้อ 8)
OCL_BIND_IP=100.104.172.122
OCL_PORT=8100
# รหัสผ่าน Postgres ของ service db (compose ocl) ตั้งยาว ๆ แล้วไม่ต้องใช้ที่อื่น
POSTGRES_PASSWORD=change-me-before-first-up
# กุญแจเซ็น token ระหว่าง web กับ api (openssl rand -hex 32) ตั้งครั้งเดียว เปลี่ยนแล้วทุกคนต้อง login ใหม่
AUTH_SECRET=change-me-openssl-rand-hex-32
# URL ที่ผู้ใช้เปิด (ใช้สร้าง callback ของ Google) · Google ไม่รับ IP ต้องเป็นชื่อโดเมนเมื่อเปิด SSO
AUTH_URL=http://100.104.172.122:8100
# Google SSO ใส่เมื่อได้ OAuth client จาก มศว (ว่าง = ปิด ใช้บัวศรีไอดีอย่างเดียว)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_ALLOWED_DOMAIN=g.swu.ac.th
